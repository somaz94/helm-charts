# Patterns to ignore when building Helm packages.
.DS_Store
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/

# upgrade.sh bookkeeping — chart-maintainer tooling, not shipped in tarballs.
upgrade.sh
backup/

# CI fixtures (ct lint, make template/validate in CI and locally); not shipped in the package.
ci/

# Upstream kubernetes.yml snapshot (written by upgrade.sh, read by scripts/validate/check-upstream-rbac.sh).
upstream/
