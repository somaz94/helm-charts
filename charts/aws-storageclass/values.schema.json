{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aws-storageclass values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "properties": {
    "commonLabels": { "$ref": "#/$defs/stringMap" },
    "commonAnnotations": { "$ref": "#/$defs/stringMap" },

    "storageClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provisioner"],
        "properties": {
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "provisioner": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "parameters": { "$ref": "#/$defs/stringMap" },
          "volumeBindingMode": { "type": "string", "enum": ["Immediate", "WaitForFirstConsumer"] },
          "reclaimPolicy": { "type": "string", "enum": ["Retain", "Delete"] },
          "allowVolumeExpansion": { "type": "boolean" },
          "mountOptions": { "type": "array", "items": { "type": "string" } },
          "allowedTopologies": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "labels": { "$ref": "#/$defs/stringMap" },
          "annotations": { "$ref": "#/$defs/stringMap" },
          "parametersExtra": { "$ref": "#/$defs/stringMap" }
        }
      }
    }
  }
}
